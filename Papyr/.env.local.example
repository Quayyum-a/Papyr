# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Production URL for email redirects (update to your live URL)
NEXT_PUBLIC_APP_URL=https://papyr-app-mu.vercel.app

# Handwriting Recognition - MyScript iink (PRIMARY)
# Get credentials from MyScript Cloud: https://cloud.myscript.com/
# Free tier: 2,000 requests/month
MYSCRIPT_APPLICATION_KEY=your_myscript_application_key
MYSCRIPT_HMAC_KEY=your_myscript_hmac_key

# Recognition Configuration (optional - defaults shown)
# RECOGNITION_QUIET_PERIOD_MS=1000
# RECOGNITION_MAX_CONCURRENT_JOBS=2
# RECOGNITION_MAX_RETRIES=3
# RECOGNITION_LANGUAGE=en_US

# Handwriting Recognition - Google Cloud Vision (ALTERNATIVE - Free tier: 1,000 requests/month)
# Follow setup guide in GOOGLE_CLOUD_VISION_SETUP.md
# For local development: Path to credentials JSON file
GOOGLE_CLOUD_VISION_CREDENTIALS=/Users/YOUR_USERNAME/.google-cloud-credentials/papyr-vision.json
# For production (Vercel): Entire JSON content as string (set in Vercel dashboard)
# GOOGLE_CLOUD_VISION_CREDENTIALS_JSON={"type":"service_account",...}
# Optional: Explicitly set project ID
# GOOGLE_CLOUD_PROJECT_ID=papyr-production

# Handwriting Recognition - OpenRouter (ALTERNATIVE - Uses AI vision models)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODELS=nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free