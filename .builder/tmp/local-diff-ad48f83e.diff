[L:12] +  const dialogRef = useRef<HTMLDivElement>(null);
[L:13] +
[L:14] +  useEffect(() => {
[L:15] +    if (!open) return;
[L:16] +
[L:17] +    const previouslyFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
[L:18] +    const handleKeyDown = (event: KeyboardEvent) => {
[L:19] +      if (event.key === 'Escape') {
[L:20] +        onClose();
[L:21] +        return;
[L:22] +      }
[L:23] +
[L:24] +      if (event.key !== 'Tab') return;
[L:25] +
[L:26] +      const focusableElements = dialogRef.current?.querySelectorAll<HTMLElement>(
[L:27] +        'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
[L:28] +      );
[L:29] +      if (!focusableElements?.length) {
[L:30] +        event.preventDefault();
[L:31] +        dialogRef.current?.focus();
[L:32] +        return;
[L:33] +      }
[L:34] +
[L:35] +      const firstElement = focusableElements[0];
[L:36] +      const lastElement = focusableElements[focusableElements.length - 1];
[L:37] +      if (event.shiftKey && (document.activeElement === firstElement || document.activeElement === dialogRef.current)) {
[L:38] +        event.preventDefault();
[L:39] +        lastElement.focus();
[L:40] +      } else if (!event.shiftKey && document.activeElement === lastElement) {
[L:41] +        event.preventDefault();
[L:42] +        firstElement.focus();
[L:43] +      }
[L:44] +    };
[L:45] +
[L:46] +    dialogRef.current?.focus();
[L:47] +    document.addEventListener('keydown', handleKeyDown);
[L:48] +    return () => {
[L:49] +      document.removeEventListener('keydown', handleKeyDown);
[L:50] +      previouslyFocusedElement?.focus();
[L:51] +    };
[L:52] +  }, [open, onClose]);
[L:53] +
[L:54] +  if (!open) return null;
[L:55] +
[L:56] +  return (
[L:57] +    <div
[L:58] +      className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4"
[L:59] +      data-testid="modal-backdrop"
[L:60] +      onClick={onClose}
[L:61] +    >
[L:62] +      <div
[L:63] +        ref={dialogRef}
[L:64] +        role="dialog"
[L:65] +        aria-modal="true"
[L:66] +        aria-label={ariaLabel}
[L:67] +        tabIndex={-1}
[L:68] +        className="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl"
[L:69] +        onClick={(event) => event.stopPropagation()}
[L:70] +      >
